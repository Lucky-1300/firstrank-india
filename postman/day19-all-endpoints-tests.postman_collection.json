{
  "info": {
    "name": "Day19 - All Endpoints API Tests",
    "description": "End-to-end tests for auth, exam, result, and ranking endpoints with standard JSON response checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Day19 User\",\n  \"email\": \"day19.user@example.com\",\n  \"password\": \"Test@1234\",\n  \"mobile\": \"9999999999\",\n  \"city\": \"Delhi\",\n  \"state\": \"Delhi\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 or 400', function () {",
              "  pm.expect([201, 400]).to.include(pm.response.code);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test('Standard JSON keys exist', function () {",
              "  pm.expect(jsonData).to.have.property('success');",
              "  pm.expect(jsonData).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"day19.user@example.com\",\n  \"password\": \"Test@1234\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.test('Token and userId exist', function () {",
              "  pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
              "  pm.expect(jsonData.data.id).to.be.a('string');",
              "});",
              "pm.collectionVariables.set('token', jsonData.token);",
              "pm.collectionVariables.set('userId', jsonData.data.id);",
              "pm.collectionVariables.set('city', jsonData.data.city || 'Delhi');",
              "pm.collectionVariables.set('state', jsonData.data.state || 'Delhi');"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth - Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "profile"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "const jsonData = pm.response.json();",
              "pm.expect(jsonData.success).to.eql(true);",
              "pm.expect(jsonData).to.have.property('data');"
            ]
          }
        }
      ]
    },
    {
      "name": "Exam - Questions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/exam/questions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "exam",
            "questions"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "const jsonData = pm.response.json();",
              "pm.expect(jsonData.success).to.eql(true);",
              "pm.expect(jsonData.data).to.be.an('array');",
              "if (jsonData.data.length > 0) {",
              "  const q = jsonData.data[0];",
              "  pm.collectionVariables.set('questionId', q._id);",
              "  pm.collectionVariables.set('selectedOption', q.options && q.options.length ? q.options[0] : '');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Exam - Submit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answers\": [\n    {\n      \"questionId\": \"{{questionId}}\",\n      \"selectedOption\": \"{{selectedOption}}\"\n    }\n  ],\n  \"timeTaken\": 120\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/exam/submit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "exam",
            "submit"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);",
              "const jsonData = pm.response.json();",
              "pm.expect(jsonData.success).to.eql(true);",
              "pm.expect(jsonData.data).to.be.an('object');"
            ]
          }
        }
      ]
    },
    {
