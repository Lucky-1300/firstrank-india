          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 or 402', function(){ pm.expect([200,402]).to.include(pm.response.code); });",
              "const jsonData = pm.response.json();",
              "pm.expect(jsonData).to.have.property('success');"
            ]
          }
        }
      ]
    },
